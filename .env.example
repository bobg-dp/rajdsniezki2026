# Frontend build-time environment.
# Backend runtime uses `backend.env` for production-like settings
# and `backend.local.env` for local testing.

PORT=8787

# Frontend build-time API URL.
# Local development: http://localhost:8787
# Production example: https://rajdsniezki.rallydevil.com
VITE_API_BASE_URL=http://localhost:8787

# Allowed browser origins for cross-origin requests to the backend.
# Local development: http://localhost:5173
# Production example: https://rajdsniezki.pl
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sportity documents endpoint base.
NOTICE_BOARD_API_KEY=
NOTICE_BOARD_API_URL=https://admin.sportity.com/api/documents
NOTICE_BOARD_AUTH_HEADER=X-Sportity-ApiKey

# Trzy poziomy imprezy mają osobne tablice ogłoszeń.
NOTICE_BOARD_EVENT_ID_RO=
NOTICE_BOARD_EVENT_PASSWORD_RO=
NOTICE_BOARD_EVENT_ID_RS=
NOTICE_BOARD_EVENT_PASSWORD_RS=
NOTICE_BOARD_EVENT_ID_KJS=
NOTICE_BOARD_EVENT_PASSWORD_KJS=

# Local development can use a mock response file instead of the live Sportity API.
NOTICE_BOARD_MOCK_MODE=false
NOTICE_BOARD_MOCK_DATA_FILE=server/data/notice-board.sample.json
