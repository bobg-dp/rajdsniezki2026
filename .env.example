# Frontend build-time environment.
# Leave this empty. The site and the API share one origin, and `vite dev`
# proxies `/api` to the local Worker on port 8787. Set an absolute URL only
# when the API is hosted somewhere else.
VITE_API_BASE_URL=

# Local Worker secrets are copied from `backend.env` and `backend.local.env`
# into `.dev.vars` by `npm run dev:backend`. Production secrets are set with
# `wrangler secret put`, not in this file.

# Allowed browser origins, only when the API is called from another host.
# Same-origin requests (production and the Vite proxy) do not need this.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sportity documents endpoint base.
NOTICE_BOARD_API_KEY=
NOTICE_BOARD_API_URL=https://admin.sportity.com/api/documents
NOTICE_BOARD_AUTH_HEADER=X-Sportity-ApiKey

# Trzy poziomy imprezy mają osobne tablice ogłoszeń.
NOTICE_BOARD_EVENT_ID_RO=
NOTICE_BOARD_EVENT_PASSWORD_RO=
NOTICE_BOARD_EVENT_ID_RS=
NOTICE_BOARD_EVENT_PASSWORD_RS=
NOTICE_BOARD_EVENT_ID_KJS=
NOTICE_BOARD_EVENT_PASSWORD_KJS=

# Set to true to serve the bundled sample board instead of Sportity.
NOTICE_BOARD_MOCK_MODE=false
