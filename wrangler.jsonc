{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rajdsniezki",
  "compatibility_date": "2026-10-05",
  // Worker bez własnego skryptu – serwuje wyłącznie statyczny build z `dist/`.
  // Dlatego nie ma tu `main` ani `assets.binding`: binding bez `main` jest
  // błędem konfiguracji, a cały backend stoi osobno na VPS-ie.
  "assets": {
    "directory": "./dist",
    // Adresy bez pasującego pliku dostają prerenderowany `dist/404.html`
    // ze statusem 404. Bez tego Worker zwróciłby goły komunikat.
    "not_found_handling": "404-page"
  }
}
