{
  "name": "rajdsniezki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "node scripts/write-dev-vars.mjs && mkdir -p dist && CI=1 wrangler d1 migrations apply rajdsniezki --local && wrangler dev --port 8787 --local",
    "start": "npm run dev:backend",
    "build": "node scripts/generate-sitemap.js && vite-ssg build",
    "preview": "vite preview"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@unhead/vue": "^2.0.19",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.5",
    "vite-ssg": "^28.3.0",
    "wrangler": "^4.147.0"
  }
}
