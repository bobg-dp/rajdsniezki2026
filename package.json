{
  "name": "rajdsniezki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "NODE_ENV=development node --watch server/index.js",
    "start": "npm run start:backend",
    "start:backend": "NODE_ENV=production node server/index.js",
    "build": "node scripts/generate-sitemap.js && vite-ssg build",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "gsap": "^3.12.5",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@unhead/vue": "^2.0.19",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.5",
    "vite-ssg": "^28.3.0"
  }
}
