[Unit]
Description=Rajd Śnieżki backend
After=network.target

[Service]
Type=simple
User=rally
Group=rally
WorkingDirectory=/var/www/rajdsniezki
Environment=NODE_ENV=production
EnvironmentFile=/etc/rajdsniezki/backend.env
ExecStart=/usr/bin/npm run start:backend
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target